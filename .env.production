# Build-time values for the production site.
#
# These are PUBLIC values. The anon key is the same one every visitor's
# browser downloads along with the page, so committing it exposes nothing
# that is not already public. What actually protects customer data is the
# row-level security in SUPABASE_AUTH_LOCKDOWN.sql.
#
# React reads this file while building and bakes both values into the
# bundle. Without it the build succeeds but every page renders blank.
REACT_APP_SUPABASE_URL=https://gjbfxcfvrlhhqbffeujv.supabase.co
REACT_APP_SUPABASE_ANON_KEY=sb_publishable_Jwx9HbYqicOsnyO9ejsTkQ_hiwUjBuy
